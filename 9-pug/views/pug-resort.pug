doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    link(rel="stylesheet", href="resort.css")
    title Resort
  body.index-container
    //- header
    header.header
      img.logo(src="images/pet-resort-logo.webp", alt="Loga")
      h2  Pet resort
      ul
        li  #[a(href="#") Home]
        li  #[a(href="#") About]
        li  #[a(href="#") Rooms]
    //- main
    main.main.card
      h2 Pet Resort
      p Where Pets Are Royalty

    //-offer
    offer.offer.card
      img.card-img(src="images/groomin.webp")
      h2 Ocktober Grooming 
      p Get your best ready for a total make-over while at the same time being spoilt silly 
      a(href="#") Book Groming

    //- Partners
    partners.card.partners
